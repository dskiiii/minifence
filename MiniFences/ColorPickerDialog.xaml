<Window x:Class="MiniFences.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="540"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1B222A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="PaletteSwatch" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#647382"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwatchBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="#E8EEF5" />
            <Setter Property="Background" Value="#25313C" />
            <Setter Property="BorderBrush" Value="#465564" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303D49" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#718394" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#187FC4" />
            <Setter Property="BorderBrush" Value="#55B6F2" />
        </Style>

        <Style x:Key="ValueTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="#F2F6F9" />
            <Setter Property="Background" Value="#131920" />
            <Setter Property="BorderBrush" Value="#465564" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#55B6F2" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" Background="#26333F" CornerRadius="3" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#55B6F2" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#F8FBFD" Stroke="#55B6F2" StrokeThickness="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1B222A"
            BorderBrush="#516171"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="212" />
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#263746" CornerRadius="7" Margin="0,0,11,0">
                        <Grid>
                            <Ellipse Width="13" Height="13" Fill="#55B6F2" />
                            <Ellipse Width="5" Height="5" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="WindowTitleText"
                               Text="选择颜色"
                               Foreground="#F5F8FB"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Content="×"
                        FontSize="20"
                        Foreground="#B8C6D2"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
            </Grid>

            <TextBlock x:Name="PromptText"
                       Grid.Row="1"
                       Foreground="#AFC0CF"
                       FontSize="12"
                       Margin="0,0,0,9" />

            <Grid x:Name="ColorField"
                  Grid.Row="2"
                  ClipToBounds="True"
                  Background="#FFFF0000"
                  MouseLeftButtonDown="ColorField_MouseLeftButtonDown"
                  MouseMove="ColorField_MouseMove"
                  MouseLeftButtonUp="ColorField_MouseLeftButtonUp">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="ColorFieldThumb"
                             Width="16"
                             Height="16"
                             Fill="Transparent"
                             Stroke="White"
                             StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <Grid Grid.Row="3" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HueLabel" Text="色相" Foreground="#AFC0CF" FontSize="12" VerticalAlignment="Center" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Border Height="12" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FFFF0000" Offset="0" />
                                <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                <GradientStop Color="#FFFF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Slider x:Name="HueSlider"
                            Minimum="0"
                            Maximum="360"
                            ValueChanged="HueSlider_ValueChanged"
                            Background="Transparent" />
                </Grid>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="52" Background="#11171D" BorderBrush="#465564" BorderThickness="1">
                    <Grid>
                        <Border x:Name="PreviousSwatch" Margin="5" />
                        <TextBlock x:Name="PreviousLabel" Text="原颜色" Foreground="White" Background="#88000000"
                                   Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Height="52" Background="#11171D" BorderBrush="#55B6F2" BorderThickness="2">
                    <Grid>
                        <Border x:Name="PreviewSwatch" Margin="4" />
                        <TextBlock x:Name="CurrentLabel" Text="新颜色" Foreground="White" Background="#88000000"
                                   Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="5" Columns="10" Rows="4" Margin="-3,0,-3,10">
                <Button Style="{StaticResource PaletteSwatch}" Tag="#FFFFFF" Background="#FFFFFFFF" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#E9ECEF" Background="#FFE9ECEF" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#ADB5BD" Background="#FFADB5BD" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#6C757D" Background="#FF6C757D" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#343A40" Background="#FF343A40" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#101418" Background="#FF101418" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#FF8787" Background="#FFFF8787" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#FFA94D" Background="#FFFFA94D" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#FFE066" Background="#FFFFE066" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#8CE99A" Background="#FF8CE99A" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#63E6BE" Background="#FF63E6BE" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#66D9E8" Background="#FF66D9E8" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#74C0FC" Background="#FF74C0FC" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#91A7FF" Background="#FF91A7FF" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#B197FC" Background="#FFB197FC" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#E599F7" Background="#FFE599F7" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#FAA2C1" Background="#FFFAA2C1" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#FF6B6B" Background="#FFFF6B6B" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#F76707" Background="#FFF76707" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#F59F00" Background="#FFF59F00" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#37B24D" Background="#FF37B24D" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#0CA678" Background="#FF0CA678" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#1098AD" Background="#FF1098AD" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#1C7ED6" Background="#FF1C7ED6" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#4263EB" Background="#FF4263EB" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#7048E8" Background="#FF7048E8" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#AE3EC9" Background="#FFAE3EC9" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#D6336C" Background="#FFD6336C" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#C92A2A" Background="#FFC92A2A" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#A61E4D" Background="#FFA61E4D" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#862E9C" Background="#FF862E9C" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#5F3DC4" Background="#FF5F3DC4" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#364FC7" Background="#FF364FC7" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#1864AB" Background="#FF1864AB" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#0B7285" Background="#FF0B7285" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#087F5B" Background="#FF087F5B" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#2B8A3E" Background="#FF2B8A3E" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#5C940D" Background="#FF5C940D" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#E67700" Background="#FFE67700" Click="PaletteButton_Click" />
                <Button Style="{StaticResource PaletteSwatch}" Tag="#D9480F" Background="#FFD9480F" Click="PaletteButton_Click" />
            </UniformGrid>

            <Grid Grid.Row="6" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OpacityLabel" Text="透明度" Foreground="#AFC0CF" FontSize="12" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="255"
                        ValueChanged="OpacitySlider_ValueChanged" />
                <TextBlock x:Name="OpacityValueText" Grid.Column="2" Foreground="#E3EBF1" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="7" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HexLabel" Text="HEX" Foreground="#AFC0CF" FontSize="12" VerticalAlignment="Center" />
                <TextBox x:Name="HexTextBox" Grid.Column="1" Style="{StaticResource ValueTextBox}"
                         TextChanged="HexTextBox_TextChanged" />
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R" Foreground="#AFC0CF" VerticalAlignment="Center" />
                    <TextBox x:Name="RedTextBox" Grid.Column="1" Style="{StaticResource ValueTextBox}" TextChanged="RgbTextBox_TextChanged" />
                    <TextBlock Grid.Column="2" Text="G" Foreground="#AFC0CF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBox x:Name="GreenTextBox" Grid.Column="3" Style="{StaticResource ValueTextBox}" TextChanged="RgbTextBox_TextChanged" />
                    <TextBlock Grid.Column="4" Text="B" Foreground="#AFC0CF" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBox x:Name="BlueTextBox" Grid.Column="5" Style="{StaticResource ValueTextBox}" TextChanged="RgbTextBox_TextChanged" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" Content="取消"
                        Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="应用"
                        IsDefault="True" Click="OkButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
