<UserControl x:Class="MiniFences.FenceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniFences"
        xmlns:controls="clr-namespace:MiniFences.Controls"
             xmlns:s="clr-namespace:System.Windows.Shapes;assembly=PresentationFramework"
             AllowDrop="True"
             PreviewDragOver="FenceControl_PreviewDragOver"
             PreviewDrop="FenceControl_PreviewDrop"
             DragEnter="FenceControl_DragEnter"
             DragLeave="FenceControl_DragLeave"
             DragOver="FenceControl_DragOver"
             Drop="FenceControl_Drop"
             ContextMenuOpening="FenceControl_ContextMenuOpening"
             PreviewMouseLeftButtonDown="FenceControl_PreviewMouseLeftButtonDown"
             PreviewMouseMove="FenceControl_PreviewMouseMove"
             PreviewMouseWheel="FenceControl_PreviewMouseWheel"
             MouseEnter="FenceControl_MouseEnter"
             MouseLeave="FenceControl_MouseLeave"
             MinWidth="240"
             MinHeight="180">
    <UserControl.Resources>
        <local:DesktopIconLabelConverter x:Key="DesktopIconLabelConverter" />
    </UserControl.Resources>
    <UserControl.ContextMenu>
        <ContextMenu x:Name="FenceContextMenu" Opened="FenceContextMenu_Opened">
            <MenuItem x:Name="NewFenceMenuItem" Header="New Fence" Click="NewFenceMenuItem_Click" />
            <MenuItem x:Name="HoverExpandMenuItem" Header="Expand on Hover" IsCheckable="True" Click="HoverExpandMenuItem_Click" />
            <MenuItem x:Name="LockFenceMenuItem" Header="Lock Fence" IsCheckable="True" Click="LockFenceMenuItem_Click" />
            <MenuItem x:Name="UnstackTabMenuItem" Header="Remove from Tab Stack" Click="UnstackTabMenuItem_Click" />
            <Separator />
            <MenuItem x:Name="RenameFenceMenuItem" Header="Rename Fence" Click="RenameFenceMenuItem_Click" />
            <MenuItem x:Name="ChooseFolderMenuItem" Header="Choose Folder..." Click="ChooseFolderMenuItem_Click" />
            <MenuItem x:Name="OpenBoundFolderMenuItem" Header="Open Bound Folder" Click="OpenBoundFolderMenuItem_Click" />
            <MenuItem x:Name="MovePageMenuItem" Header="Move to Page">
                <MenuItem x:Name="MoveToPreviousPageMenuItem" Header="Previous Page" Click="MoveToPreviousPageMenuItem_Click" />
                <MenuItem x:Name="MoveToNextPageMenuItem" Header="Next Page" Click="MoveToNextPageMenuItem_Click" />
                <MenuItem x:Name="MoveToNewPageMenuItem" Header="New Page" Click="MoveToNewPageMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="SortMenuItem" Header="Sort by">
                <MenuItem x:Name="SortNoneMenuItem" Tag="None" Header="None" IsCheckable="True" Click="SortMenuItem_Click" />
                <MenuItem x:Name="SortNameMenuItem" Tag="Name" Header="Name" IsCheckable="True" Click="SortMenuItem_Click" />
                <MenuItem x:Name="SortSizeMenuItem" Tag="Size" Header="Size" IsCheckable="True" Click="SortMenuItem_Click" />
                <MenuItem x:Name="SortTypeMenuItem" Tag="ItemType" Header="Item type" IsCheckable="True" Click="SortMenuItem_Click" />
                <MenuItem x:Name="SortModifiedMenuItem" Tag="Modified" Header="Modified" IsCheckable="True" Click="SortMenuItem_Click" />
                <MenuItem x:Name="SortCreatedMenuItem" Tag="Created" Header="Created" IsCheckable="True" Click="SortMenuItem_Click" />
                <MenuItem x:Name="SortCategoryMenuItem" Tag="Category" Header="Category" IsCheckable="True" Click="SortMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="PortalViewMenuItem" Header="View">
                <MenuItem x:Name="PortalIconsViewMenuItem" Header="Icons" Tag="Icons" IsCheckable="True"
                          PreviewMouseLeftButtonDown="PortalViewMenuItem_PreviewMouseLeftButtonDown" />
                <MenuItem x:Name="PortalListViewMenuItem" Header="List" Tag="List" IsCheckable="True"
                          PreviewMouseLeftButtonDown="PortalViewMenuItem_PreviewMouseLeftButtonDown" />
                <Separator />
                <MenuItem x:Name="PortalSmallIconsMenuItem" Header="Small icons" Tag="32" IsCheckable="True" Click="PortalIconSizeMenuItem_Click" />
                <MenuItem x:Name="PortalMediumIconsMenuItem" Header="Medium icons" Tag="42" IsCheckable="True" Click="PortalIconSizeMenuItem_Click" />
                <MenuItem x:Name="PortalLargeIconsMenuItem" Header="Large icons" Tag="56" IsCheckable="True" Click="PortalIconSizeMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="PortalCompactSpacingMenuItem" Header="Compact spacing" Tag="2" IsCheckable="True" Click="PortalSpacingMenuItem_Click" />
                <MenuItem x:Name="PortalComfortableSpacingMenuItem" Header="Comfortable spacing" Tag="6" IsCheckable="True" Click="PortalSpacingMenuItem_Click" />
                <MenuItem x:Name="PortalSpaciousSpacingMenuItem" Header="Spacious spacing" Tag="10" IsCheckable="True" Click="PortalSpacingMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="StyleMenuItem" Header="Style">
                <MenuItem x:Name="CopyStyleMenuItem" Header="Copy Style" Click="CopyStyleMenuItem_Click" />
                <MenuItem x:Name="PasteStyleMenuItem" Header="Paste Style" Click="PasteStyleMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ChooseBackgroundColorMenuItem"
                          Header="Choose Background Color..."
                          PreviewMouseLeftButtonDown="ChooseBackgroundColorMenuItem_PreviewMouseLeftButtonDown" />
                <MenuItem x:Name="ChooseHeaderColorMenuItem"
                          Header="Choose Header Color..."
                          PreviewMouseLeftButtonDown="ChooseHeaderColorMenuItem_PreviewMouseLeftButtonDown" />
                <Separator />
                <MenuItem x:Name="OpacityMenuItem" Header="Opacity">
                    <MenuItem Tag="0" Header="0%" IsCheckable="True" Click="OpacityMenuItem_Click" />
                    <MenuItem Tag="20" Header="20%" IsCheckable="True" Click="OpacityMenuItem_Click" />
                    <MenuItem Tag="40" Header="40%" IsCheckable="True" Click="OpacityMenuItem_Click" />
                    <MenuItem Tag="60" Header="60%" IsCheckable="True" Click="OpacityMenuItem_Click" />
                    <MenuItem Tag="80" Header="80%" IsCheckable="True" Click="OpacityMenuItem_Click" />
                    <MenuItem Tag="100" Header="100%" IsCheckable="True" Click="OpacityMenuItem_Click" />
                </MenuItem>
                <MenuItem x:Name="ResetStyleMenuItem" Header="Reset Style" Click="ResetStyleMenuItem_Click" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="DeleteFenceMenuItem" Header="Delete Fence" Click="DeleteFenceMenuItem_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border x:Name="OuterBorder"
            BorderBrush="#88FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Background="#DD20242A"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FirstRow" Height="34" />
                <RowDefinition x:Name="ContentRow" Height="*" />
                <RowDefinition x:Name="FooterRow" Height="22" />
            </Grid.RowDefinitions>

            <Border x:Name="ContentBackground"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Background="#DD20242A"
                    CornerRadius="0,0,8,8" />

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="#CC3F7FA8"
                    CornerRadius="8,8,0,0"
                    Cursor="Arrow"
                    PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    LostMouseCapture="TitleBar_LostMouseCapture">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="TabNavigationPanel" Orientation="Horizontal" Margin="8,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="‹" Width="20" Foreground="White" FontSize="18" TextAlignment="Center"
                                   Cursor="Hand" ToolTip="Previous tab" MouseLeftButtonDown="PreviousTab_MouseLeftButtonDown" />
                        <TextBlock x:Name="TabStatusText" MinWidth="32" Foreground="#DDFFFFFF" FontSize="11"
                                   TextAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                   ToolTip="Choose tab" MouseLeftButtonDown="TabStatusText_MouseLeftButtonDown" />
                        <TextBlock Text="›" Width="20" Foreground="White" FontSize="18" TextAlignment="Center"
                                   Cursor="Hand" ToolTip="Next tab" MouseLeftButtonDown="NextTab_MouseLeftButtonDown" />
                    </StackPanel>
                    <Grid x:Name="TabStripPanel" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Visibility="Collapsed" />
                    <Grid x:Name="MergePreview" Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Margin="3,3"
                                Background="#E6F59E0B" BorderBrush="#FFFFF4D6"
                                BorderThickness="2" CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFB020" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="MergePreviewPulse" Grid.Column="1" Margin="3,3"
                                BorderBrush="White" BorderThickness="2" CornerRadius="5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ContentArea" Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="StatusText"
                               Foreground="#CCDDE6EF"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <DockPanel x:Name="PortalNavigationBar" Visibility="Collapsed" LastChildFill="True">
                        <Button x:Name="PortalBackButton" Content="‹" Width="26" Height="24" Margin="0,0,4,0"
                                Padding="0" Click="PortalBackButton_Click" ToolTip="Back" />
                        <Button x:Name="PortalUpButton" Content="↑" Width="26" Height="24" Margin="0,0,7,0"
                                Padding="0" Click="PortalUpButton_Click" ToolTip="Up" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PortalBreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <ListView x:Name="ItemsList"
                          Grid.Row="1"
                          AllowDrop="True"
                          Background="#16FFFFFF"
                          BorderThickness="0"
                          Foreground="White"
                          SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ContextMenuOpening="ItemsList_ContextMenuOpening"
                          SelectionChanged="ItemsList_SelectionChanged"
                          ScrollViewer.ScrollChanged="ItemsList_ScrollChanged"
                          PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                          PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ItemsList_PreviewMouseMove"
                          KeyDown="ItemsList_KeyDown">
                    <ListView.Resources>
                        <DataTemplate x:Key="PortalListItemTemplate">
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="118" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Tag="ListTypeColumn" Text="{Binding Kind}" Foreground="#AFFFFFFF"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Tag="ListSizeColumn" Text="{Binding DisplaySize}"
                                           Foreground="#AFFFFFFF" TextAlignment="Left" Margin="0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Tag="ListTimeColumn" Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Foreground="#88FFFFFF" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="9" />
                            <Setter Property="MinWidth" Value="9" />
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Width="9" Background="Transparent">
                                            <Track x:Name="PART_Track"
                                                   IsDirectionReversed="True"
                                                   Focusable="False">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                  Opacity="0"
                                                                  Focusable="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Width="5" MinHeight="34">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border x:Name="ThumbBorder"
                                                                        Background="#88FFFFFF"
                                                                        CornerRadius="3" />
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#CCFFFFFF" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#FFFFFFFF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                  Opacity="0"
                                                                  Focusable="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                             Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel IsItemsHost="True" ItemWidth="94" ItemHeight="100" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="OpenItemMenuItem" Header="Open" Click="OpenItemMenuItem_Click" />
                            <MenuItem x:Name="RenameItemMenuItem" Header="Rename" Click="RenameItemMenuItem_Click" />
                            <MenuItem x:Name="ShowItemInExplorerMenuItem" Header="Show in Explorer" Click="ShowItemInExplorerMenuItem_Click" />
                            <MenuItem x:Name="CopyItemPathMenuItem" Header="Copy Path" Click="CopyItemPathMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="DeleteItemMenuItem" Header="Delete" Click="DeleteItemMenuItem_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AllowDrop" Value="True" />
                            <Setter Property="Width" Value="86" />
                            <Setter Property="Height" Value="92" />
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemChrome"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="4">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemChrome" Property="Background" Value="#24FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemChrome" Property="Background" Value="#780078D7" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True" />
                                                    <Condition Property="Tag" Value="SingleSelectedIcon" />
                                                </MultiTrigger.Conditions>
                                                <!-- A single icon selection is drawn by the expanded
                                                     overlay so its full filename can grow past the cell. -->
                                                <Setter TargetName="ItemChrome" Property="Background" Value="Transparent" />
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True" />
                                                    <Condition Property="Tag" Value="List" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="ItemChrome" Property="Background" Value="#780078D7" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseDoubleClick" Handler="Item_MouseDoubleClick" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Item_PreviewMouseLeftButtonDown" />
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_PreviewMouseLeftButtonUp" />
                            <EventSetter Event="MouseMove" Handler="Item_MouseMove" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_PreviewMouseRightButtonDown" />
                            <EventSetter Event="DragOver" Handler="Item_DragOver" />
                            <EventSetter Event="Drop" Handler="Item_Drop" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Grid Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="52" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0"
                                           Width="42"
                                           Height="42"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="CompactItemName"
                                                   Text="{Binding Name, Converter={StaticResource DesktopIconLabelConverter}, ConverterParameter=78}"
                                                   FontFamily="Microsoft YaHei UI"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="None"
                                                   LineHeight="15"
                                                   Height="30"
                                                   MaxHeight="30"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Canvas x:Name="ItemLabelOverlayCanvas"
                        Grid.Row="1"
                        ClipToBounds="True"
                        Panel.ZIndex="40"
                        SizeChanged="ItemLabelOverlayCanvas_SizeChanged">
                    <Border x:Name="ExpandedItemLabelOverlay"
                            Width="86"
                            MinHeight="92"
                            Padding="4"
                            Background="#480078D7"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0"
                                   Width="42"
                                   Height="42"
                                   Source="{Binding Icon}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                            <TextBlock x:Name="ExpandedItemLabelText"
                                       Grid.Row="1"
                                       Foreground="White"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       LineHeight="15"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="ExpandedItemRenameTextBox"
                                     Grid.Row="1"
                                     Visibility="Collapsed"
                                     FontSize="12"
                                     TextAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     TextChanged="ItemRenameTextBox_TextChanged"
                                     KeyDown="ItemRenameTextBox_KeyDown"
                                     LostKeyboardFocus="ItemRenameTextBox_LostKeyboardFocus" />
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>

            <DockPanel x:Name="FooterPanel" Grid.Row="2" Margin="8,0,24,4">
                <TextBlock x:Name="FooterHintText"
                           DockPanel.Dock="Left"
                           Foreground="#99FFFFFF"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="Right-click for options." />
            </DockPanel>
            <Thumb x:Name="ResizeThumb"
                   Grid.Row="0"
                   Grid.RowSpan="3"
                   Width="18"
                   Height="18"
                   Margin="0,0,4,4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Panel.ZIndex="20"
                   Visibility="Collapsed"
                   Tag="Bottom"
                   Cursor="SizeNWSE"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="#22000000">
                            <Path x:Name="BottomResizeGrip"
                                  Stroke="#CCFFFFFF"
                                  StrokeThickness="1.2"
                                  Data="M 3 15 L 15 3 M 9 15 L 15 9" />
                            <Path x:Name="TopResizeGrip"
                                  Visibility="Collapsed"
                                  Stroke="#CCFFFFFF"
                                  StrokeThickness="1.2"
                                  Data="M 3 3 L 15 15 M 9 3 L 15 9" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Top">
                                <Setter TargetName="BottomResizeGrip" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TopResizeGrip" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Border x:Name="DropHighlightBorder"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    BorderBrush="DeepSkyBlue"
                    BorderThickness="2"
                    CornerRadius="8"
                    Panel.ZIndex="30"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
